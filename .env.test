# ═══════════════════════════════════════════════════
# ✨ YAE-BACKEND Server Configuration
# ═══════════════════════════════════════════════════

# ───────────────────────────────────────────────────
# 🌐 Server Settings
# ───────────────────────────────────────────────────
PORT                =   3001

# ───────────────────────────────────────────────────
# 🌐 Service PASSWORD(as you want!)
# ───────────────────────────────────────────────────
SERVICE_BOT_TOKEN   = ABCDEFG

# ───────────────────────────────────────────────────
# 🔐 Security & Authentication
# ⚠️  CRITICAL: Change these secrets before deployment!
# ───────────────────────────────────────────────────
JWT_SECRET          =   CHANGE_ME_TO_A_LONG_RANDOM_STRING
BACKEND_SECRET      =   CHANGE_ME_TOO
SERVICE_JWT_SECRET  =   CHANGE_ME_TO_A_LONG_RANDOM_STRING_FOR_SERVICES


# ═══════════════════════════════════════════════════
# 🤖 LLM Service Configuration (vLLM)
# Repository: https://github.com/OuOSama/YAE-AI
# ═══════════════════════════════════════════════════

# 💬 Text & Chat LLM
VLLM_LLM_URL        =   http://localhost:8000/v1
VLLM_LLM_KEY        =   YOUR_LLM_API_KEY

# 🔍 Embedding Model
VLLM_EMB_URL        =   http://localhost:8001/v1
VLLM_EMB_KEY        =   YOUR_EMB_API_KEY


# ═══════════════════════════════════════════════════
# 🗄️  Database Configuration (PostgreSQL)
# ═══════════════════════════════════════════════════

# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# Examples:
# Local:     postgresql://myuser:mysecretpassword@localhost:5432/mydatabase
# Supabase:  postgresql://postgres.<ref>:<pass>@<ref>.pooler.supabase.com:6543/postgres
# Neon:      postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require

DATABASE_URL        =   postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# ═══════════════════════════════════════════════════
# 💟  Discord OAuth2
# ═══════════════════════════════════════════════════

# Discord developers portal: https://discord.com/developers/docs/intro

DISCORD_CLIENT_ID       = CLIENT_ID
DISCORD_CLIENT_SECRET   = CLIENT_SECRET

# ═══════════════════════════════════════════════════
# 📝 Important Notes
# ═══════════════════════════════════════════════════
# • Never commit this file to version control
# • Use .env.example as a template
# • Generate strong secrets (min 32 characters)
# ═══════════════════════════════════════════════════
