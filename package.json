{
	"name": "yae-backend",
	"version": "1.0.50",
	"scripts": {
		"dev": "bun run --bun --watch src/app.ts",
		"start": "bun run src/app.ts",
		"check": "bunx biome check --write --no-errors-on-unmatched",
		"prepare": "bunx husky"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.11",
		"elysia": "latest"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.3",
		"bun-types": "latest",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6"
	},
	"lint-staged": {
		"*.{ts,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"license": "MIT"
}
