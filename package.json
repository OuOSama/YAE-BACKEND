{
	"name": "yae-backend",
	"version": "1.0.0",
	"scripts": {
		"dev": "NODE_ENV=development bun --bun run --watch src/app.ts",
		"start": "NODE_ENV=production bun --bun run src/app.ts",
		"biome": "bunx --bun @biomejs/biome check --write",
		"prepare": "husky"
	},
	"dependencies": {
		"@elysia/openapi": "^1.4.15",
		"better-auth": "^1.6.23",
		"drizzle-orm": "^1.0.0-rc.4",
		"elysia": "latest",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"bun-types": "latest",
		"drizzle-kit": "^1.0.0-rc.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8"
	},
	"lint-staged": {
		"*.{ts,json}": [
			"biome check --write --unsafe --no-errors-on-unmatched"
		]
	},
	"license": "MIT"
}
