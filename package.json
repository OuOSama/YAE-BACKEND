{
	"name": "yae-backend",
	"version": "1.0.0",
	"scripts": {
		"dev": "bun run --watch src/app.ts",
		"biome": "bunx --bun @biomejs/biome check --write",
		"prepare": "husky"
	},
	"dependencies": {
		"elysia": "latest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"bun-types": "latest",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8"
	},
	"lint-staged": {
		"*.{ts,json}": [
			"biome check --write --unsafe --no-errors-on-unmatched"
		]
	}
}
