{
	"name": "yae-backend",
	"version": "1.0.0",
	"scripts": {
		"dev": "NODE_ENV=development bun --bun run --watch src/app.ts",
		"start": "NODE_ENV=production bun --bun run src/app.ts",
		"biome": "bunx --bun @biomejs/biome check --write",
		"prepare": "husky",
		"db:gen": "bunx drizzle-kit generate",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:push": "bunx drizzle-kit push"
	},
	"dependencies": {
		"@elysia/cors": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"better-auth": "^1.6.26",
		"drizzle-orm": "^0.45.2",
		"drizzle-typebox": "^0.3.3",
		"elysia": "latest",
		"logixlysia": "^6.7.0",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"bun-types": "latest",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0"
	},
	"lint-staged": {
		"*.{ts,json}": [
			"biome check --write --unsafe --no-errors-on-unmatched"
		]
	},
	"license": "MIT"
}
